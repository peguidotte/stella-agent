# ==============================================================================
# STELLA AGENT - Variáveis de Ambiente (Template)
# ==============================================================================
# 
# Copie este arquivo para .env e preencha com suas credenciais reais
# IMPORTANTE: NUNCA commite o arquivo .env com credenciais reais!
#
# Comando: cp .env.example .env
# ==============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API (Processamento de IA)
# -----------------------------------------------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyC...SuaChaveAqui

# -----------------------------------------------------------------------------
# CloudAMQP (Mensageria para Sistema da Unidade)
# -----------------------------------------------------------------------------
# URL de conexão AMQP do CloudAMQP
CLOUDAMQP_URL=amqps://usuario:senha@servidor/vhost

# -----------------------------------------------------------------------------
# Pusher (WebSocket para comunicação em tempo real)
# -----------------------------------------------------------------------------
# Credenciais do Pusher: https://dashboard.pusher.com
PUSHER_APP_ID=123456
PUSHER_KEY=abcdef123456
PUSHER_SECRET=ghijkl789012
PUSHER_CLUSTER=us2

# -----------------------------------------------------------------------------
# Configurações da Unidade
# -----------------------------------------------------------------------------
# PIN de segurança da unidade (6 dígitos)
# IMPORTANTE: Altere o padrão 123456 para um PIN seguro!
STELLA_UNIT_PIN=123456

# ID único da unidade hospitalar
UNIT_ID=UNIT_001

# -----------------------------------------------------------------------------
# Configurações de Ambiente
# -----------------------------------------------------------------------------
# Ambiente: development, staging, production
ENVIRONMENT=development

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Configurações de Hardware (Opcional)
# -----------------------------------------------------------------------------
# ID do dispositivo de câmera (0 = padrão, 1 = segunda câmera, etc.)
# CAMERA_DEVICE_ID=0

# ID do dispositivo de microfone
# MICROPHONE_DEVICE_ID=0

# ID do dispositivo de alto-falante
# SPEAKER_DEVICE_ID=0

# -----------------------------------------------------------------------------
# Configurações Avançadas (Opcional)
# -----------------------------------------------------------------------------
# Threshold de confiança para reconhecimento facial (0.0 a 1.0)
# FACE_CONFIDENCE_THRESHOLD=0.8

# Timeout de sessão em minutos
# SESSION_TIMEOUT_MINUTES=10

# Duração de lockout após tentativas falhas (minutos)
# LOCKOUT_DURATION_MINUTES=30

# Máximo de tentativas de PIN
# MAX_PIN_ATTEMPTS=3

# Máximo de tentativas de Face ID
# MAX_FACE_ID_ATTEMPTS=3

# ==============================================================================
# NOTAS IMPORTANTES:
# ==============================================================================
# 
# 1. SEGURANÇA:
#    - Mantenha este arquivo (.env) no .gitignore
#    - Nunca compartilhe suas credenciais publicamente
#    - Rotacione suas API keys regularmente
#    - Use PINs fortes em produção
#
# 2. PRODUÇÃO:
#    - Use um gerenciador de secrets (AWS Secrets Manager, etc.)
#    - Configure HTTPS/TLS
#    - Habilite rate limiting
#    - Configure CORS adequadamente
#
# 3. DESENVOLVIMENTO:
#    - Este template é para ambiente local
#    - Solicite credenciais do time Stellar se for contribuidor
#    - Consulte INSTALLATION_GUIDE.md para mais detalhes
#
# ==============================================================================
